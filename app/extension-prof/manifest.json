{
  "manifest_version": 3,
  "name": "LOCKqz for Professors",
  "version": "1.0.13",
  "description": "Syncs your LOCKqz classes and exams with Brightspace by itself. On a student's computer, enters the exam's LOCKqz password.",
  "homepage_url": "https://professor.lockqz.com",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "power",
    "scripting"
  ],
  "host_permissions": [
    "https://brightspace.usc.edu/*",
    "https://usc.brightspace.com/*",
    "https://professor.lockqz.com/*",
    "https://lockqz.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://brightspace.usc.edu/d2l/*",
        "https://usc.brightspace.com/d2l/*"
      ],
      "js": [
        "content-bs.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://professor.lockqz.com/*"
      ],
      "js": [
        "content-dash.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://brightspace.usc.edu/d2l/lms/quizzing/user/*",
        "https://usc.brightspace.com/d2l/lms/quizzing/user/*"
      ],
      "js": [
        "content-quiz.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sync.js",
        "lq.js",
        "icon128.png"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "LOCKqz",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prof@lockqz.app",
      "strict_min_version": "121.0",
      "update_url": "https://lockqz.com/download/lockqz-prof-firefox-updates.json",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  }
}
