# LOCKqz API on a plain server: copy to lockqz.env (same folder as server.mjs), fill in, chmod 600.
# The public settings (prices, dates, addresses) are read from ../cloudflare/wrangler.toml by themselves;
# only the secrets and this server's own settings go here. Use the SAME secret values as the Cloudflare
# site, or installed computers and signed-in professors stop being recognised.
TEACHER_KEY=
ROT_SECRET=
PW_PEPPER=
PAY_SECRET=
REQUIRE_SIGNED=1
MAIL_USER=
MAIL_APP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_DETAILS=

# This server
PORT=8787
BIND=127.0.0.1
# The address the server answers for (the API host students' computers call).
PUBLIC_HOST=lockqz.com
# 1 = requests arrive through Cloudflare (Tunnel), whose CF-Connecting-IP header is the student's address.
TRUST_PROXY=1
# A whole copy of the database every N minutes (0 = off), newest SNAPSHOT_KEEP kept in data/snapshots.
SNAPSHOT_MIN=15
SNAPSHOT_KEEP=8
# Server processes sharing the port and the database: a number, or auto = one per processor.
WORKERS=auto
